# AeroShield Environment Configuration
# Copy this file to .env and fill in your values.
# All variables marked OPTIONAL will fall back to safe defaults if not set.

# ─── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Google Gemini GenAI (OPTIONAL) ─────────────────────────────────────────────
# If omitted or set to 'your_api_key_here', AeroShield automatically switches to
# its built-in expert reasoning engine — the app works fully without this key.
GEMINI_API_KEY=your_api_key_here

# Gemini model to use. gemini-2.5-flash is recommended for speed and cost.
GEMINI_MODEL=gemini-2.5-flash

# Alternative key name (also checked automatically):
# GOOGLE_API_KEY=your_api_key_here

# ─── Logging ─────────────────────────────────────────────────────────────────────
# Log verbosity level. Options: debug | info | warn | error
# Automatically set to 'error' in test environments.
LOG_LEVEL=info
